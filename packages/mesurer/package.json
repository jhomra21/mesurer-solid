{
  "name": "@jhomra21/mesurer-solid",
  "version": "0.1.0-beta.12",
  "description": "Framework-agnostic UI measurement and inspection tools for browser apps and coding agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mesurer-skill": "scripts/install-skill.mjs"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./delivery": { "types": "./dist/delivery.d.ts", "import": "./dist/delivery.js" },
    "./inject": { "types": "./dist/inject.d.ts", "import": "./dist/inject.js" },
    "./inject-script": "./dist/inject-script.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "scripts/install-skill.mjs",
    "README.md",
    "AGENT_INTEGRATION.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.core.config.ts && vite build --config vite.delivery.config.ts && vite build --config vite.inject.config.ts && vite build --config vite.inject-script.config.ts && bun scripts/check-bundle.mjs && tsc -p tsconfig.build.json && bun scripts/check-context-review.mjs && bun scripts/check-delivery-adapters.mjs && bun scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "stage": "bun scripts/stage-package.mjs",
    "pack:dry": "bun run stage && npm pack .publish --dry-run",
    "pack": "bun run stage && npm pack .publish"
  },
  "devDependencies": {
    "@jhomra21/mesurer-solid-core": "workspace:*",
    "@jhomra21/mesurer-solid-dom": "workspace:*",
    "@jhomra21/mesurer-solid-renderer": "workspace:*",
    "@solidjs/vite-plugin": "^3.0.0-next.29",
    "@solidjs/web": "2.0.0-rc.0",
    "solid-js": "2.0.0-rc.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  },
  "keywords": ["measurement", "devtools", "agent", "playwright", "solid", "react", "vue", "svelte", "electron"],
  "repository": {
    "type": "git",
    "url": "https://github.com/jhomra21/mesurer-solid.git",
    "directory": "packages/mesurer"
  },
  "bugs": { "url": "https://github.com/jhomra21/mesurer-solid/issues" },
  "homepage": "https://github.com/jhomra21/mesurer-solid#readme",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
