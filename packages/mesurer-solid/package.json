{
  "name": "@jhomra21/mesurer-solid",
  "version": "0.1.0",
  "description": "Solid renderer for Mesurer, backed by the framework-neutral Mesurer core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "styles": "bunx tailwindcss -i src/styles.css -o src/styles.generated.css && bun scripts/generate-styles.mjs",
    "build": "bun run styles && vite build && tsc -p tsconfig.build.json && bunx tailwindcss -i src/styles.css -o dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jhomra21/mesurer-core": "workspace:*",
    "@jhomra21/mesurer-dom": "workspace:*"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.0",
    "solid-js": "^2.0.0-rc.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.29",
    "@solidjs/web": "^2.0.0-rc.0",
    "@tailwindcss/cli": "^4.2.2",
    "jsdom": "^30.0.1",
    "solid-js": "^2.0.0-rc.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "keywords": ["solid", "solidjs", "measurement", "guides", "rulers", "devtools", "plugins"],
  "repository": {
    "type": "git",
    "url": "https://github.com/jhomra21/mesurer-solid.git",
    "directory": "packages/mesurer-solid"
  }
}
