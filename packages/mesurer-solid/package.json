{
  "name": "@jhomra21/mesurer-solid",
  "version": "0.1.0",
  "description": "A Solid 2-native port of Mesurer: measurement, guides, rulers, typography inspection, x-ray, and color picking for web apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && bun scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.0",
    "solid-js": "^2.0.0-rc.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.29",
    "@solidjs/web": "^2.0.0-rc.0",
    "jsdom": "^30.0.1",
    "solid-js": "^2.0.0-rc.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "keywords": ["solid", "solidjs", "measurement", "guides", "rulers", "devtools"],
  "repository": {
    "type": "git",
    "url": "https://github.com/jhomra21/mesurer-solid.git",
    "directory": "packages/mesurer-solid"
  }
}
