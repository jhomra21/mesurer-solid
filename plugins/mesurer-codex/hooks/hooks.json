{
  "description": "Keep Mesurer's local Codex feedback companion ready and report queued-turn lifecycle state.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-connect.mjs\" --session-start",
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\scripts\\\\codex-connect.mjs\" --session-start",
            "timeout": 15,
            "statusMessage": "Connecting Mesurer to this Codex thread"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-lifecycle.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\scripts\\\\codex-lifecycle.mjs\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-lifecycle.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\scripts\\\\codex-lifecycle.mjs\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-lifecycle.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\\\scripts\\\\codex-lifecycle.mjs\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
